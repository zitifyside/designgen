# ── App ────────────────────────────────────────────────────────────
APP_NAME="AI Design Generator API"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
# 허용할 CORS origin 목록 (쉼표로 구분, 프론트엔드 개발 서버)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ───────────────────────────────────────────────────────
# SQLite (기본값, 별도 설정 없이 로컬 개발 가능):
DATABASE_URL=sqlite+aiosqlite:///./designgen.db
# PostgreSQL (프로덕션 — 주석을 해제하고 requirements에 asyncpg 추가):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/designgen

# ── Auth / JWT ─────────────────────────────────────────────────────
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI pipeline ────────────────────────────────────────────────────
# true 이면 결정론 placeholder. 실제 시안을 뽑으려면 false.
# 로컬: AI_PROVIDER=codex + `codex login`. 운영 Cloud Run: gemini + GEMINI_API_KEY
# (Codex CLI 가 없으면 Gemini 로 자동 폴백).
FAKE_AI_PIPELINE=false
AI_PROVIDER=codex

# Gemini (Google) — app/services/ai/gemini.py에서 사용
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Codex CLI — ChatGPT 구독. API 키 불필요. 이 머신에서 `codex login`.
CODEX_MODEL=gpt-5.6-terra
CODEX_CLI=
CODEX_TIMEOUT_SECONDS=180
# 구 OpenAI SDK 경로(미사용). 남겨 둔 이유는 기존 env 호환.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Billing (Stripe) — 연동은 스텁 처리됨, 구현 시 채워 넣으세요 ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
